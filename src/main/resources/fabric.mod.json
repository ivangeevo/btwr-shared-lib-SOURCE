{
  "schemaVersion": 1,
  "id": "btwr_sl",
  "version": "${version}",
  "name": "BTWR: Shared Library",
  "description": "",
  "authors": [
    "ivangeevo",
    "jeffinitup"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/btwr_sl/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": ["org.btwr.shared_library.BTWRSLModClient"],
    "main": ["org.btwr.shared_library.BTWRSLMod"],
    "fabric-datagen": ["org.btwr.shared_library.datagen.BTWRSLDataGenerator"],
    "modmenu": ["org.btwr.shared_library.config.BTWRSLConfig"],
    "emi": ["org.btwr.shared_library.emi.BTWRSLEmiPlugin"]
  },
  "mixins": [
    "btwr_sl.mixins.json",
    {
      "config": "btwr_sl.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "emi": ">=1.1.22+1.21.1+fabric"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1309": ["org/btwr/shared_library/api/entity/interfaces/added/LivingEntityAdded"],
      "net/minecraft/class_1657": ["org/btwr/shared_library/api/entity/interfaces/added/PlayerEntityAdded"],
      "net/minecraft/class_2248": ["org/btwr/shared_library/api/block/interfaces/added/BlockAdded"],
      "net/minecraft/class_1792": ["org/btwr/shared_library/api/item/interfaces/added/ItemAdded"],
      "net/minecraft/class_1799": ["org/btwr/shared_library/api/item/interfaces/added/ItemStackAdded"],
      "net/minecraft/class_1937": ["org/btwr/shared_library/api/world/interfaces/added/WorldAdded"]
    }
  },
  "accessWidener" : "btwr_sl.accesswidener"
}
